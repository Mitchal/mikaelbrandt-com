// The contact form's Worker. Deploy from this folder: npm run deploy
// The GitHub token is a secret, set once with: npx wrangler@4 secret put GITHUB_TOKEN
{
  "$schema": "https://unpkg.com/wrangler@4.164.0/config-schema.json",
  "name": "mikaelbrandt-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPO": "Mitchal/mikaelbrandt-inbox",
    // localhost is the dev server in .claude/launch.json, so the form can be tried locally.
    "ALLOWED_ORIGINS": "https://mikaelbrandt.com,https://www.mikaelbrandt.com,https://mikaelbrandt.se,https://www.mikaelbrandt.se,http://localhost:8123"
  },
  // At most 5 messages a minute from one address: plenty for a person, a wall for a script.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
